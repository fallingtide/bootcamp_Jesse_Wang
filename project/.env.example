# Copy this file to .env and fill in real values.
# Never commit .env to version control.
#
# Free Alpha Vantage API key (takes ~30s to get one):
#   https://www.alphavantage.co/support/#api-key
# The pipeline falls back to yfinance if this is left empty.
ALPHAVANTAGE_API_KEY=

# Data directory overrides. If unset, the pipeline falls back to
# data/raw and data/processed respectively.
DATA_DIR_RAW=data/raw
DATA_DIR_PROCESSED=data/processed
